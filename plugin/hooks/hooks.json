{
  "description": "yunomi plugin hooks - git wt guard and mock/stub detection",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/git-wt-guard.sh",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/test-mock-guard.sh",
            "timeout": 10
          }
        ],
        "matcher": "Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/test-mock-postcheck.sh",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "Stop": [],
    "SubagentStop": []
  }
}
